# ── Firebase (client) ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Clé publique VAPID pour les notifications push (Firebase Console > Cloud Messaging > Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_public_key

# ── Firebase Admin (serveur) ─────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Émetteur de cartes (clés serveur uniquement, jamais exposées au client) ──
PAGOCARDS_PUBLIC_KEY=your_pagocards_public_key
PAGOCARDS_SECRET_KEY=your_pagocards_secret_key

# ── Passerelle de paiement Mobile Money ──────────────────────────────
GATEWAY_API_KEY=your_gateway_api_key
GATEWAY_BASE_URL=https://paymentgateway.lfdweb.com

# ── FeexPay (payouts Mobile Money automatiques) ──────────────────────
FEEXPAY_API_KEY=your_feexpay_api_key
FEEXPAY_SHOP_ID=your_feexpay_shop_id

# ── VerzaPay (payouts Mobile Money automatiques — second prestataire, secours) ───
VERZAPAY_SECRET_KEY=vpz_sk_your_secret_key

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://card.lfdweb.com

# ── Tarification ──────────────────────────────────────────────────────
CARD_CREATION_PRICE=5000
CARD_RELOAD_MIN=30000
CARD_RELOAD_MAX=500000
